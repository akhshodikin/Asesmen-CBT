                          onChange={e => setCbtKelas(e.target.value)}
                          className="w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm font-semibold bg-slate-50 focus:ring-2 focus:ring-emerald-500 focus:outline-none"
                        >
                          {['Kelas 1', 'Kelas 2', 'Kelas 3', 'Kelas 4', 'Kelas 5', 'Kelas 6'].map(k => (
                            <option key={k} value={k}>{k} ({students.filter(s => s.kelas === k).length} Siswa)</option>
                          ))}
                        </select>
                      </div>

                      <div>
                        <label className="block text-xs font-bold text-slate-700 mb-1">
                          2. Masukkan Token Ujian
                        </label>
                        <div className="relative">
                          <input
                            type="text"
                            value={cbtTokenInput}
                            onChange={e => setCbtTokenInput(e.target.value.toUpperCase())}
                            placeholder="Contoh: TENGGER26"
                            className="w-full rounded-xl border border-emerald-400 bg-emerald-50/40 px-3.5 py-2.5 text-sm font-mono font-bold text-emerald-950 focus:ring-2 focus:ring-emerald-500 focus:outline-none"
                          />
                          <Key className="w-4 h-4 text-emerald-600 absolute right-3 top-3" />
                        </div>
                      </div>
                    </div>

                    <div>
                      <label className="block text-xs font-bold text-slate-700 mb-1">
                        3. Pilih Nama Lengkap Peserta Didik ({cbtKelas})
                      </label>
                      <select
                        value={cbtStudentNipd}
                        onChange={e => setCbtStudentNipd(e.target.value)}
                        className="w-full rounded-xl border border-slate-300 px-3.5 py-2.5 text-sm font-semibold text-slate-900 focus:ring-2 focus:ring-emerald-500 focus:outline-none"
                      >
                        {students.filter(s => s.kelas === cbtKelas).map(s => (
                          <option key={s.nipd} value={s.nipd}>
                            {s.no}. {s.nama} — (NIPD: {s.nipd} | NISN: {s.nisn})
                          </option>
                        ))}
                      </select>
                    </div>

                    {/* Preview Biodata Siswa */}
                    {selectedCbtStudent && (
                      <div className="bg-slate-50 rounded-xl p-4 border border-slate-200 grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
                        <div>
                          <span className="text-slate-400 block">NIPD / No Induk</span>
                          <span className="font-bold text-slate-800">{selectedCbtStudent.nipd}</span>
                        </div>
                        <div>
                          <span className="text-slate-400 block">NISN</span>
                          <span className="font-bold text-slate-800">{selectedCbtStudent.nisn}</span>
                        </div>
                        <div>
                          <span className="text-slate-400 block">Jenis Kelamin</span>
                          <span className="font-bold text-slate-800">{selectedCbtStudent.jk === 'L' ? 'Laki-laki (L)' : 'Perempuan (P)'}</span>
                        </div>
                        <div>
                          <span className="text-slate-400 block">Agama</span>
                          <span className="font-bold text-emerald-800">{selectedCbtStudent.agama}</span>
                        </div>
                      </div>
                    )}

                    <button
                      type="submit"
                      className="w-full flex items-center justify-center gap-2 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white font-bold py-3.5 px-6 rounded-xl shadow-md transition cursor-pointer text-sm"
                    >
                      <Play className="w-4 h-4 fill-current" />
                      <span>MULAI KERJAKAN UJIAN CBT SEKARANG</span>
                    </button>
                  </form>
                </div>

                {/* Right Info Panel */}
                <div className="lg:col-span-5 bg-white rounded-2xl shadow-sm border border-slate-200 p-5 space-y-4">
                  <h4 className="font-bold text-slate-800 text-sm flex items-center gap-2 border-b border-slate-100 pb-3">
                    <ShieldCheck className="w-5 h-5 text-emerald-600" />
                    <span>Ringkasan Paket Soal CBT Aktif</span>
                  </h4>
                  <div className="space-y-2.5 text-xs">
                    <div className="flex justify-between py-1.5 border-b border-slate-100">
                      <span className="text-slate-500">Satuan Pendidikan</span>
                      <span className="font-bold text-slate-800">SDN Kandangan I Tosari</span>
                    </div>
                    <div className="flex justify-between py-1.5 border-b border-slate-100">
                      <span className="text-slate-500">Mata Pelajaran</span>
                      <span className="font-bold text-emerald-800">{config.mapel}</span>
                    </div>
                    <div className="flex justify-between py-1.5 border-b border-slate-100">
                      <span className="text-slate-500">Kelas Sasaran</span>
                      <span className="font-bold text-slate-800">{config.kelas} ({config.fase})</span>
                    </div>
                    <div className="flex justify-between py-1.5 border-b border-slate-100">
                      <span className="text-slate-500">Guru Pengampu</span>
                      <span className="font-bold text-slate-800">{config.guruNama}</span>
                    </div>
                    <div className="flex justify-between py-1.5 border-b border-slate-100">
                      <span className="text-slate-500">Jumlah Butir Soal</span>
                      <span className="font-bold text-slate-800">
                        {questions.length} Soal ({pgQuestions.length} PG, {pgkQuestions.length} PGK, {isianQuestions.length} Isian, {uraianQuestions.length} Uraian)
                      </span>
                    </div>
                    <div className="flex justify-between py-1.5">
                      <span className="text-slate-500">Total Skor Maksimal</span>
                      <span className="font-bold text-emerald-700">{questionStats.totalScore} Poin</span>
                    </div>
                  </div>

                  <div className="bg-amber-50 border border-amber-200 rounded-xl p-3.5 text-xs text-amber-900 space-y-1">
                    <strong className="block">Petunjuk Pengerjaan CBT:</strong>
                    <ul className="list-disc list-inside space-y-0.5 text-[11px]">
                      <li>Pilih jawaban dengan mengklik opsi pada layar.</li>
                      <li>Gunakan tombol <strong>Ragu-Ragu (Kuning)</strong> bila ingin meninjau ulang soal tersebut nanti.</li>
                      <li>Nilai otomatis dihitung begitu tombol <strong>Selesai Ujian</strong> ditekan.</li>
                    </ul>
                  </div>
                </div>
              </div>
            )}

            {/* STAGE 2: ANTARMUKA PENGERJAAN SOAL CBT (ALA ANBK) */}
            {cbtStage === 'exam' && questions.length > 0 && (() => {
              const currentQ = questions[cbtCurrentIndex] || questions[0];
              const currentAns = cbtAnswers[currentQ.nomor];
              const isDoubtful = !!cbtDoubt[currentQ.nomor];
              const answeredCount = Object.keys(cbtAnswers).filter(k => {
                const v = cbtAnswers[k];
                return Array.isArray(v) ? v.length > 0 : Boolean(v && v.toString().trim() !== '');
              }).length;

              return (
                <div className="space-y-4">
                  {/* CBT Exam Top Bar */}
                  <div className="bg-slate-900 text-white rounded-2xl p-4 shadow-md flex flex-wrap items-center justify-between gap-4">
                    <div className="flex items-center gap-3">
                      <div className="w-10 h-10 rounded-xl bg-emerald-600 flex items-center justify-center font-extrabold text-base">
                        {selectedCbtStudent?.nama?.charAt(0) || 'S'}
                      </div>
                      <div>
                        <div className="flex items-center gap-2">
                          <span className="font-bold text-sm md:text-base text-white">{selectedCbtStudent?.nama}</span>
                          <span className="bg-emerald-500/30 border border-emerald-400/40 text-emerald-200 text-[10px] px-2 py-0.5 rounded font-semibold">
                            {selectedCbtStudent?.kelas} | NIPD: {selectedCbtStudent?.nipd}
                          </span>
                        </div>
                        <p className="text-xs text-slate-300">
                          {config.mapel} — {config.jenisAsesmen}
                        </p>
                      </div>
                    </div>

                    <div className="flex items-center gap-3">
                      {/* Ukuran Font */}
                      <div className="bg-slate-800 border border-slate-700 rounded-xl px-3 py-1.5 flex items-center gap-1.5 text-xs">
                        <span className="text-slate-400 mr-1">Ukuran Teks:</span>
                        {[
                          { id: 'sm', label: 'A-' },
                          { id: 'normal', label: 'A' },
                          { id: 'lg', label: 'A+' }
                        ].map(sz => (
                          <button
                            key={sz.id}
                            type="button"
                            onClick={() => setCbtFontSize(sz.id)}
                            className={`px-2 py-0.5 rounded font-bold cursor-pointer ${
                              cbtFontSize === sz.id ? 'bg-amber-400 text-slate-950' : 'text-slate-300 hover:bg-slate-700'
                            }`}
                          >
                            {sz.label}
                          </button>
                        ))}
                      </div>

                      {/* Timer Countdown */}
                      <div className={`flex items-center gap-2 px-4 py-2 rounded-xl font-mono font-bold text-base border ${
                        cbtTimeLeft < 300 ? 'bg-rose-600 border-rose-400 animate-pulse' : 'bg-emerald-800 border-emerald-600'
                      }`}>
                        <Clock className="w-4 h-4 text-amber-300" />
                        <span>{formatTimer(cbtTimeLeft)}</span>
                      </div>
                    </div>
                  </div>

                  {/* Main Exam Grid */}
                  <div className="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                    {/* Left Panel: Question & Answer Area */}
                    <div className="lg:col-span-8 bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden flex flex-col justify-between min-h-[460px]">
                      <div>
                        {/* Question Header */}
                        <div className="bg-slate-50 border-b border-slate-200 px-6 py-3.5 flex flex-wrap items-center justify-between gap-2">
                          <div className="flex items-center gap-2.5">
                            <span className="bg-emerald-700 text-white font-extrabold text-sm px-3 py-1 rounded-lg">
                              SOAL NO. {currentQ.nomor}
                            </span>
                            <span className="text-xs font-semibold bg-slate-200 text-slate-700 px-2.5 py-1 rounded-md">
                              {currentQ.bentuk === 'PG' ? 'Pilihan Ganda' : currentQ.bentuk === 'PGK' ? 'Pilihan Ganda Kompleks' : currentQ.bentuk === 'Isian' ? 'Isian Singkat' : 'Uraian / Essay'}
                            </span>
                          </div>
                          <div className="flex items-center gap-2 text-xs">
                            <span className="bg-teal-50 text-teal-800 border border-teal-200 px-2 py-0.5 rounded font-semibold">
                              Bloom: {currentQ.bloom}
                            </span>
                            <span className="bg-amber-50 text-amber-800 border border-amber-200 px-2 py-0.5 rounded font-semibold">
                              Bobot: {currentQ.skor} Poin
                            </span>
                          </div>
                        </div>

                        {/* Question Content */}
                        <div className={`p-6 space-y-5 ${
                          cbtFontSize === 'sm' ? 'text-sm' : cbtFontSize === 'lg' ? 'text-lg' : 'text-base'
                        }`}>
                          {currentQ.stimulus && (
                            <div className="bg-slate-50 border-l-4 border-emerald-600 p-4 rounded-r-xl text-slate-700 whitespace-pre-line leading-relaxed">
                              {currentQ.stimulus}
                            </div>
                          )}

                          <div className="font-semibold text-slate-900 leading-relaxed">
                            {currentQ.pertanyaan}
                          </div>

                          {/* OPTIONS FOR PG */}
                          {currentQ.bentuk === 'PG' && (
                            <div className="space-y-2.5 pt-2">
                              {(currentQ.opsi || []).map((opt, idx) => {
                                const letter = String.fromCharCode(65 + idx);
                                const isSelected = currentAns === letter;
                                const cleanText = opt.replace(/^[A-Da-d][\.\)]\s*/, '');
                                return (
                                  <button
                                    key={idx}
                                    type="button"
                                    onClick={() => handleSelectPGOption(currentQ.nomor, letter)}
                                    className={`w-full text-left p-3.5 rounded-xl border-2 transition flex items-start gap-3.5 cursor-pointer ${
                                      isSelected
                                        ? 'border-emerald-600 bg-emerald-50/80 text-emerald-950 font-semibold shadow-sm'
                                        : 'border-slate-200 hover:border-emerald-300 hover:bg-slate-50 text-slate-800'
                                    }`}
                                  >
                                    <span className={`w-7 h-7 rounded-full flex items-center justify-center font-bold text-sm shrink-0 mt-0.5 ${
                                      isSelected ? 'bg-emerald-600 text-white' : 'bg-slate-200 text-slate-700'
                                    }`}>
                                      {letter}
                                    </span>
                                    <span className="flex-1 leading-snug">{cleanText}</span>
                                  </button>
                                );
                              })}
                            </div>
                          )}

                          {/* OPTIONS FOR PGK */}
                          {currentQ.bentuk === 'PGK' && (
                            <div className="space-y-2.5 pt-2">
                              <p className="text-xs font-semibold text-amber-700 bg-amber-50 px-3 py-1.5 rounded-lg inline-block">
                                Petunjuk: Klik pada kotak pernyataan yang benar (Jawaban benar lebih dari satu)
                              </p>
                              {(currentQ.opsi || []).map((opt, idx) => {
                                const selectedArr = Array.isArray(currentAns) ? currentAns : [];
                                const isChecked = selectedArr.includes(idx);
                                const cleanText = opt.replace(/^\[\s*\]\s*/, '');
                                return (
                                  <button
                                    key={idx}
                                    type="button"
                                    onClick={() => handleTogglePGKOption(currentQ.nomor, idx)}
                                    className={`w-full text-left p-3.5 rounded-xl border-2 transition flex items-start gap-3.5 cursor-pointer ${
                                      isChecked
                                        ? 'border-emerald-600 bg-emerald-50/80 text-emerald-950 font-semibold shadow-sm'
                                        : 'border-slate-200 hover:border-emerald-300 hover:bg-slate-50 text-slate-800'
                                    }`}
                                  >
                                    <span className={`w-6 h-6 rounded-md flex items-center justify-center font-bold text-xs shrink-0 mt-0.5 border ${
                                      isChecked ? 'bg-emerald-600 border-emerald-600 text-white' : 'bg-white border-slate-400 text-transparent'
                                    }`}>
                                      ✓
                                    </span>
                                    <span className="flex-1 leading-snug">{cleanText}</span>
                                  </button>
                                );
                              })}
                            </div>
                          )}

                          {/* INPUT FOR ISIAN SINGKAT */}
                          {currentQ.bentuk === 'Isian' && (
                            <div className="pt-2 space-y-2">
                              <label className="block text-xs font-bold uppercase text-slate-500">
                                Ketik Jawaban Singkat Anda:
                              </label>
                              <input
                                type="text"
                                value={currentAns || ''}
                                onChange={e => handleTextAnswerChange(currentQ.nomor, e.target.value)}
                                placeholder="Ketik jawaban singkat di sini..."
                                className="w-full rounded-xl border-2 border-slate-300 focus:border-emerald-600 px-4 py-3 text-base font-semibold text-slate-900 focus:outline-none"
                              />
                            </div>
                          )}

                          {/* TEXTAREA FOR URAIAN */}
                          {currentQ.bentuk === 'Uraian' && (
                            <div className="pt-2 space-y-2">
                              <label className="block text-xs font-bold uppercase text-slate-500">
                                Ketik Jawaban Uraian Lengkap Anda:
                              </label>
                              <textarea
                                rows={4}
                                value={currentAns || ''}
                                onChange={e => handleTextAnswerChange(currentQ.nomor, e.target.value)}
                                placeholder="Tuliskan penjelasan atau langkah penyelesaian secara lengkap di sini..."
                                className="w-full rounded-xl border-2 border-slate-300 focus:border-emerald-600 p-4 text-base text-slate-900 focus:outline-none"
                              />
                            </div>
                          )}
                        </div>
                      </div>

                      {/* Bottom Navigation Buttons */}
                      <div className="bg-slate-50 border-t border-slate-200 px-6 py-4 flex flex-wrap items-center justify-between gap-3">
                        <button
                          type="button"
                          disabled={cbtCurrentIndex === 0}
                          onClick={() => setCbtCurrentIndex(prev => Math.max(0, prev - 1))}
                          className="flex items-center gap-1.5 bg-white hover:bg-slate-100 disabled:opacity-40 text-slate-700 font-bold px-4 py-2.5 rounded-xl border border-slate-300 text-xs md:text-sm transition cursor-pointer"
                        >
                          <ChevronLeft className="w-4 h-4" /> Soal Sebelumnya
                        </button>

                        <button
                          type="button"
                          onClick={() => handleToggleDoubt(currentQ.nomor)}
                          className={`flex items-center gap-2 font-bold px-4 py-2.5 rounded-xl text-xs md:text-sm border transition cursor-pointer ${
                            isDoubtful
                              ? 'bg-amber-400 text-amber-950 border-amber-500 shadow-sm'
                              : 'bg-amber-50 hover:bg-amber-100 text-amber-800 border-amber-300'
                          }`}
                        >
                          <Flag className="w-4 h-4" />
                          <span>{isDoubtful ? 'Ditandai Ragu-Ragu' : 'Ragu-Ragu'}</span>
                        </button>

                        {cbtCurrentIndex < questions.length - 1 ? (
                          <button
                            type="button"
                            onClick={() => setCbtCurrentIndex(prev => Math.min(questions.length - 1, prev + 1))}
                            className="flex items-center gap-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-5 py-2.5 rounded-xl text-xs md:text-sm shadow transition cursor-pointer"
                          >
                            <span>Soal Selanjutnya</span> <ChevronRight className="w-4 h-4" />
                          </button>
                        ) : (
                          <button
                            type="button"
                            onClick={() => setCbtConfirmSubmit(true)}
                            className="flex items-center gap-1.5 bg-rose-600 hover:bg-rose-700 text-white font-bold px-5 py-2.5 rounded-xl text-xs md:text-sm shadow transition cursor-pointer"
                          >
                            <CheckCircle2 className="w-4 h-4" />
                            <span>Selesai & Kumpulkan</span>
                          </button>
                        )}
                      </div>
                    </div>

                    {/* Right Panel: Question Number Grid */}
                    <div className="lg:col-span-4 bg-white rounded-2xl shadow-sm border border-slate-200 p-5 space-y-4">
                      <div className="flex items-center justify-between border-b border-slate-100 pb-3">
                        <span className="font-bold text-slate-800 text-sm">Navigasi Nomor Soal</span>
                        <span className="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full">
                          Terjawab: {answeredCount}/{questions.length}
                        </span>
                      </div>

                      <div className="grid grid-cols-5 gap-2">
                        {questions.map((q, idx) => {
                          const ans = cbtAnswers[q.nomor];
                          const hasAns = Array.isArray(ans) ? ans.length > 0 : Boolean(ans && ans.toString().trim() !== '');
                          const doubt = !!cbtDoubt[q.nomor];
                          const isCurrent = idx === cbtCurrentIndex;

                          let btnClass = 'bg-slate-100 text-slate-700 border-slate-300 hover:bg-slate-200';
                          if (doubt) {
                            btnClass = 'bg-amber-400 text-amber-950 border-amber-500 font-extrabold';
                          } else if (hasAns) {
                            btnClass = 'bg-emerald-600 text-white border-emerald-700 font-bold';
                          }

                          return (
                            <button
                              key={q.nomor}
                              type="button"
                              onClick={() => setCbtCurrentIndex(idx)}
                              className={`h-11 rounded-xl border-2 text-xs flex flex-col items-center justify-center transition cursor-pointer ${btnClass} ${
                                isCurrent ? 'ring-2 ring-offset-2 ring-slate-900 scale-105' : ''
                              }`}
                            >
                              <span>{q.nomor}</span>
                              {hasAns && typeof ans === 'string' && ans.length <= 2 && (
                                <span className="text-[9px] opacity-90">{ans}</span>
                              )}
                            </button>
                          );
                        })}
                      </div>

                      {/* Legend */}
                      <div className="grid grid-cols-3 gap-2 pt-2 border-t border-slate-100 text-[11px] text-slate-600">
                        <div className="flex items-center gap-1.5">
                          <span className="w-3.5 h-3.5 rounded bg-emerald-600 inline-block"></span>
                          <span>Sudah Dijawab</span>
                        </div>
                        <div className="flex items-center gap-1.5">
                          <span className="w-3.5 h-3.5 rounded bg-amber-400 inline-block"></span>
                          <span>Ragu-Ragu</span>
                        </div>
                        <div className="flex items-center gap-1.5">
                          <span className="w-3.5 h-3.5 rounded bg-slate-200 border border-slate-300 inline-block"></span>
                          <span>Belum Dijawab</span>
                        </div>
                      </div>

                      {/* Submit Confirmation Box */}
                      {!cbtConfirmSubmit ? (
                        <button
                          type="button"
                          onClick={() => setCbtConfirmSubmit(true)}
                          className="w-full bg-slate-900 hover:bg-slate-800 text-white font-bold py-3 rounded-xl text-xs shadow transition cursor-pointer flex items-center justify-center gap-2"
                        >
                          <CheckSquare className="w-4 h-4 text-amber-400" />
                          <span>Hentikan & Kumpulkan Jawaban Ujian</span>
                        </button>
                      ) : (
                        <div className="bg-rose-50 border-2 border-rose-300 rounded-xl p-4 space-y-3">
                          <p className="text-xs font-bold text-rose-900">
                            Konfirmasi Pengumpulan Ujian:
                          </p>
                          <p className="text-xs text-rose-700">
                            Anda telah menjawab <strong>{answeredCount} dari {questions.length} soal</strong>. Apakah Anda yakin ingin mengakhiri ujian dan melihat hasil nilai?
                          </p>
                          <div className="flex gap-2">
                            <button
                              type="button"
                              onClick={handleFinishCBTExam}
                              className="flex-1 bg-rose-600 hover:bg-rose-700 text-white font-bold py-2 rounded-lg text-xs cursor-pointer"
                            >
                              Ya, Selesai Ujian
                            </button>
                            <button
                              type="button"
                              onClick={() => setCbtConfirmSubmit(false)}
                              className="flex-1 bg-white hover:bg-slate-100 text-slate-700 font-semibold py-2 rounded-lg border border-slate-300 text-xs cursor-pointer"
                            >
                              Batal
                            </button>
                          </div>
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              );
            })()}

            {/* STAGE 3: HASIL UJIAN CBT SISWA & ANALISIS TAKSONOMI BLOOM */}
            {cbtStage === 'result' && cbtLastResult && (
              <div className="bg-white rounded-2xl shadow-md border border-slate-200 p-6 md:p-8 space-y-6">
                <div className="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 border-b border-slate-200 pb-5">
                  <div>
                    <span className="bg-emerald-100 text-emerald-800 text-xs font-extrabold px-3 py-1 rounded-full">
                      UJIAN CBT SELESAI DIREKAM
                    </span>
                    <h3 className="text-2xl font-extrabold text-slate-900 mt-2">
                      {cbtLastResult.nama}
                    </h3>
                    <p className="text-xs text-slate-500">
                      Kelas: <strong>{cbtLastResult.kelas}</strong> | NIPD: <strong>{cbtLastResult.nipd}</strong> | NISN: <strong>{cbtLastResult.nisn}</strong> | Mapel: <strong>{cbtLastResult.mapel}</strong>
                    </p>
                  </div>

                  <div className="flex items-center gap-4 bg-gradient-to-br from-emerald-700 to-teal-800 text-white px-6 py-4 rounded-2xl shadow">
                    <div className="text-right">
                      <span className="text-[11px] uppercase tracking-wider text-emerald-200 block">Nilai Akhir CBT</span>
                      <span className="text-3xl font-extrabold">{cbtLastResult.nilaiAkhir}</span>
                    </div>
                    <div className="border-l border-emerald-500/50 pl-4 text-xs">

                        <p className="font-extrabold uppercase text-xs">UPT SATUAN PENDIDIKAN SDN KANDANGAN I TOSARI</p>
                        <p className="font-bold uppercase text-[10px] underline mt-0.5">
                          KARTU PESERTA & AKSES CBT {config.jenisAsesmen} — TP {config.tahunPelajaran}
                        </p>
                      </div>
                      <table className="w-full no-border text-[11px]">
                        <tbody>
                          <tr>
                            <td className="font-bold py-0.5 w-28">Nama Peserta</td>
                            <td className="w-2">:</td>
                            <td className="font-bold">{s.nama}</td>
                          </tr>
                          <tr>
                            <td className="font-bold py-0.5">NIPD / NISN</td>
                            <td>:</td>
                            <td>{s.nipd} / {s.nisn}</td>
                          </tr>
                          <tr>
                            <td className="font-bold py-0.5">Kelas / JK</td>
                            <td>:</td>
                            <td>{s.kelas} / {s.jk === 'L' ? 'Laki-laki' : 'Perempuan'}</td>
                          </tr>
                          <tr>
                            <td className="font-bold py-0.5">Agama</td>
                            <td>:</td>
                            <td>{s.agama}</td>
                          </tr>
                          <tr>
                            <td className="font-bold py-0.5">Username / Token CBT</td>
                            <td>:</td>
                            <td className="font-mono font-bold">{s.nipd} / Token: {config.tokenCBT}</td>
                          </tr>
                        </tbody>
                      </table>
                      <div className="mt-3 flex justify-between items-end text-[10px]">
                        <div className="border border-black w-14 h-16 flex items-center justify-center text-slate-400">
                          Foto 3x4
                        </div>
                        <div className="text-center">
                          <p>{config.tanggalTtd}</p>
                          <p>Kepala Sekolah,</p>
                          <div className="h-8"></div>
                          <p className="font-bold underline">{config.kepsekNama}</p>
                          <p>NIP. {config.kepsekNip}</p>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        )}

        {/* ============================================================
            TAB 6: DATA MASTER GURU SDN KANDANGAN I TOSARI
           ============================================================ */}
        {activeTab === 'guru' && (
          <div className="grid grid-cols-1 lg:grid-cols-12 gap-6 no-print">
            <div className="lg:col-span-8 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4">
              <div className="flex items-center justify-between border-b border-slate-100 pb-3">
                <div>
                  <h3 className="font-bold text-slate-800 text-base">
                    Data Master Pendidik SDN Kandangan I Tosari
                  </h3>
                  <p className="text-xs text-slate-500">
                    Data otomatis terhubung ke kolom tanda tangan Naskah Soal, Kisi-Kisi, dan Daftar Nilai saat Kelas/Mapel dipilih.
                  </p>
                </div>
              </div>

              <div className="overflow-x-auto">
                <table className="w-full text-left border-collapse text-xs">
                  <thead>
                    <tr className="bg-slate-100 text-slate-700 border-b border-slate-200">
                      <th className="p-3">Nama Guru (Edit Langsung)</th>
                      <th className="p-3">NIP</th>
                      <th className="p-3">Jabatan</th>
                      <th className="p-3">Unit / Kelas Diampu</th>
                      <th className="p-3">Kontak WA & Email</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-200">
                    {teachers.map((t, i) => (
                      <tr key={t.id} className="hover:bg-slate-50">
                        <td className="p-2.5">
                          <input
                            type="text"
                            value={t.nama}
                            onChange={e => {
                              const updated = [...teachers];
                              updated[i].nama = e.target.value;
                              setTeachers(updated);
                            }}
                            className="w-full font-semibold text-slate-800 border border-slate-200 rounded px-2 py-1"
                          />
                        </td>
                        <td className="p-2.5">
                          <input
                            type="text"
                            value={t.nip}
                            onChange={e => {
                              const updated = [...teachers];
                              updated[i].nip = e.target.value;
                              setTeachers(updated);
                            }}
                            className="w-full font-mono text-slate-700 border border-slate-200 rounded px-2 py-1"
                          />
                        </td>
                        <td className="p-2.5 text-slate-600">{t.jabatan}</td>
                        <td className="p-2.5">
                          <span className="bg-emerald-100 text-emerald-900 font-semibold px-2.5 py-1 rounded-full">
                            {t.ugk}
                          </span>
                        </td>
                        <td className="p-2.5 text-slate-500">
                          <div>{t.wa}</div>
                          <div className="text-[11px] text-slate-400">{t.email}</div>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>

            <div className="lg:col-span-4 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4 h-fit">
              <h3 className="font-bold text-slate-800 text-base border-b border-slate-100 pb-3">
                Tambah Guru Kelas / Guru Mapel
              </h3>
              <form onSubmit={handleAddTeacher} className="space-y-3 text-xs">
                <div>
                  <label className="font-semibold text-slate-600 block mb-1">Nama Lengkap & Gelar</label>
                  <input
                    type="text"
                    required
                    value={newTeacher.nama}
                    onChange={e => setNewTeacher({ ...newTeacher, nama: e.target.value })}
                    placeholder="Contoh: Budi Santoso, S.Pd."
                    className="w-full border border-slate-300 rounded-lg px-3 py-2"
                  />
                </div>
                <div>
                  <label className="font-semibold text-slate-600 block mb-1">NIP</label>
                  <input
                    type="text"
                    value={newTeacher.nip}
                    onChange={e => setNewTeacher({ ...newTeacher, nip: e.target.value })}
                    placeholder="199xxxxxxxxxxxxxxx"
                    className="w-full border border-slate-300 rounded-lg px-3 py-2"
                  />
                </div>
                <div>
                  <label className="font-semibold text-slate-600 block mb-1">Jabatan</label>
                  <select
                    value={newTeacher.jabatan}
                    onChange={e => setNewTeacher({ ...newTeacher, jabatan: e.target.value })}
                    className="w-full border border-slate-300 rounded-lg px-3 py-2"
                  >
                    <option value="Guru Kelas">Guru Kelas</option>
                    <option value="Guru Mata Pelajaran">Guru Mata Pelajaran</option>
                  </select>
                </div>
                <div>
                  <label className="font-semibold text-slate-600 block mb-1">Kelas / Mata Pelajaran Diampu</label>
                  <input
                    type="text"
                    value={newTeacher.ugk}
                    onChange={e => setNewTeacher({ ...newTeacher, ugk: e.target.value })}
                    placeholder="Contoh: Kelas 2 atau PJOK"
                    className="w-full border border-slate-300 rounded-lg px-3 py-2"
                  />
                </div>
                <button
                  type="submit"
                  className="w-full bg-emerald-700 hover:bg-emerald-800 text-white font-bold py-2.5 rounded-lg transition cursor-pointer"
                >
                  Simpan ke Data Master Guru
                </button>
              </form>
            </div>
          </div>
        )}
      </main>
    </div>
  );
}